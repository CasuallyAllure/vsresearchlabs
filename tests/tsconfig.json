{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  // priceCheck.ts is listed explicitly, not left to transitive resolution from
  // priceCheck.test.ts: it is the checkout price-verification module, and it is
  // the one file under supabase/functions/ that tsc can read (it is
  // deliberately free of Deno globals and remote imports so vitest can drive
  // it). Naming it here keeps it typechecked even if the test's import moves.
  // The rest of supabase/functions/ is Deno and is gated by `deno check` in CI.
  "include": [
    "**/*.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../supabase/functions/place-order/priceCheck.ts",
    "../supabase/functions/place-order/rewardVoucher.ts"
  ]
}
