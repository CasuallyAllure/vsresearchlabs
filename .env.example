# =============================================================================
# VS Research Labs — Environment Variables
# =============================================================================
# Copy to .env for local dev. For production, set these in the appropriate
# vault (Cloudflare Pages for frontend, Supabase secrets for Edge Functions).
# =============================================================================


# ── FRONTEND (Vite) ─────────────────────────────────────────────────────────
# Public — embedded in the built JS bundle. Safe to commit/leak (RLS gates data).
# In production, set these in Cloudflare Pages → Settings → Environment variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# DEPRECATED. The AdminGate now uses real Supabase Auth.
# Leave unset; kept for backward compatibility with old AdminGate behaviour.
VITE_ADMIN_PASSPHRASE=


# ── EDGE FUNCTIONS (Supabase) — server-side only ────────────────────────────
# DO NOT set these in Cloudflare or commit to git. Set via:
#   Supabase Dashboard → Edge Functions → Manage secrets
# or:
#   supabase secrets set KEY=value

# Auto-injected by Supabase runtime — DO NOT set manually.
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY

# Used by send-inquiry, send-order-invoice, send-shipment-notification.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=VS Research Labs <inquiries@vsresearchlabs.com>

# Used by send-inquiry (business notification inbox).
INQUIRY_TO_EMAIL=inquiries@vsresearchlabs.com

# CORS lockdown for Edge Functions. Use '*' during initial smoke-test;
# switch to your live origin (e.g. https://vsresearchlabs.com) before
# announcing.
ALLOWED_ORIGIN=https://vsresearchlabs.com
