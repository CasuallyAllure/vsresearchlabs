# =============================================================================
# VS Research Labs — Environment Variables
# =============================================================================
# Copy to .env for local dev. For production, set these in the appropriate
# vault (Cloudflare Pages for frontend, Supabase secrets for Edge Functions).
# =============================================================================


# ── FRONTEND (Vite) ─────────────────────────────────────────────────────────
# Public — embedded in the built JS bundle. Safe to commit/leak (RLS gates data).
# In production, set these in Cloudflare Pages → Settings → Environment variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the PUBLISHABLE anon key (sb_publishable_…, Supabase dashboard → API
# keys) — it is what the production build bakes. The legacy JWT anon key still
# works but is rotation-prone; building with anything else makes the deployed
# frontend irreproducible from the checkout (2026-07-17 review finding).
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# DEPRECATED. The AdminGate now uses real Supabase Auth.
# Leave unset; kept for backward compatibility with old AdminGate behaviour.
VITE_ADMIN_PASSPHRASE=

# Payment handles shown on the ON-SCREEN order confirmation. Set the
# matching Supabase secrets (below) to the same values so the emailed
# invoice and the on-screen instructions agree.
VITE_ZELLE_HANDLE=
VITE_PAYPAL_HANDLE=


# ── EDGE FUNCTIONS (Supabase) — server-side only ────────────────────────────
# DO NOT set these in Cloudflare or commit to git. Set via:
#   Supabase Dashboard → Edge Functions → Manage secrets
# or:
#   supabase secrets set KEY=value

# Auto-injected by Supabase runtime — DO NOT set manually.
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY

# Used by send-inquiry, send-order-invoice, send-shipment-notification.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=VS Research Labs <inquiries@vsresearchlabs.com>

# Used by send-inquiry / place-order (business notification inbox).
INQUIRY_TO_EMAIL=inquiries@vsresearchlabs.com

# Used by place-order — the emailed invoice's payment instructions.
# REQUIRED for the order flow. Match VITE_ZELLE_HANDLE / VITE_PAYPAL_HANDLE.
#   ZELLE_HANDLE  = phone/email your Zelle is registered to
#   PAYPAL_HANDLE = your paypal.me link or PayPal email
ZELLE_HANDLE=
PAYPAL_HANDLE=
# Optional: hosted PNG of public/brand-stamp.svg for the email header.
# If unset, the email falls back to a built-in text version of the stamp.
BRAND_STAMP_URL=

# Email brand identity (supabase/functions/_shared/emailBrand.ts). Every value
# falls back to the VS Research Labs string, so VSR needs none of these set.
# WHITE-LABEL CLIENTS MUST SET ALL FIVE — otherwise their order emails render
# with VS Research Labs branding.
EMAIL_BRAND_NAME=
EMAIL_BRAND_TAGLINE=
EMAIL_BRAND_SIGNATURE=
EMAIL_LOGO_URL=
EMAIL_OPS_EMAIL=

# CORS lockdown for Edge Functions. Use '*' during initial smoke-test;
# switch to your live origin (e.g. https://vsresearchlabs.com) before
# announcing.
ALLOWED_ORIGIN=https://vsresearchlabs.com
