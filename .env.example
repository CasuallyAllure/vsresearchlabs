# Frontend (Vite) — public
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Functions (Supabase) — server-only
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
RESEND_FROM_EMAIL=

# Optional: gate /admin in the browser. If unset, /admin is open.
VITE_ADMIN_PASSPHRASE=

# Edge Function CORS — set to your production domain to lock down send-inquiry.
# Omit or leave empty in development to allow all origins (*).
ALLOWED_ORIGIN=
