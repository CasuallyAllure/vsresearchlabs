{
  // Cloudflare Worker that serves the static Vite build (dist/).
  // Deploy:  npx wrangler deploy   (Build command must run `npm run build` first)
  "name": "vsresearchlabs",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
